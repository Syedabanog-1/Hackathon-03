# LearnFlow Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# OpenAI API (for AI agent services)
OPENAI_API_KEY=sk-proj-...

# Qdrant Vector DB (MCP data source for mcp-code-execution skill)
QDRANT_URL=https://your-cluster.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Neon PostgreSQL (main database + Better Auth store)
DATABASE_URL=postgres://user:password@ep-xxx.us-east-1.aws.neon.tech/verceldb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/verceldb?sslmode=require
NEON_API_KEY=napi_...

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
