# LearnFlow Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# OpenAI API (for AI agent services)
OPENAI_API_KEY=sk-proj-...

# Qdrant Vector DB (MCP data source for mcp-code-execution skill)
QDRANT_URL=https://your-cluster.us-east4-0.gcp.cloud.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key

# Neon PostgreSQL (main database + Better Auth store)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
NEON_API_KEY=napi_...

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Frontend API base URL (Railway API URL in production, Kong URL locally)
NEXT_PUBLIC_KONG_URL=http://localhost:8000

# DigitalOcean — for cloud deployments
DIGITALOCEAN_ACCESS_TOKEN=dop_v1_your-token-here

# Anthropic API — required for AI Tutor Chat
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
