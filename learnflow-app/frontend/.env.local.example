# LearnFlow Frontend — Environment Variables
# Copy to .env.local and fill in your values. NEVER commit .env.local to git.
#
# ─── Better Auth (REQUIRED for login/signup) ──────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=your-secret-here-change-this

# The canonical URL of this frontend deployment (NO trailing slash):
#   Local dev  → http://localhost:3000
#   Netlify    → https://hack03.netlify.app
#   Vercel     → https://hackathon-03-sandy.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Same value as above but public (accessible in browser JS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Neon PostgreSQL (REQUIRED — stores users & sessions) ─────────────────────
# Get from neon.tech → your project → Connection String → Pooled
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ─── Backend API (REQUIRED for AI tutor, code execution, progress) ────────────
#   Local dev  → http://localhost:8000  (run uvicorn in learnflow-app/api/)
#   Production → https://hackathon-03-production.up.railway.app
NEXT_PUBLIC_KONG_URL=http://localhost:8000

# ─── Anthropic API (REQUIRED for AI Tutor Chat) ────────────────────────────────
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ─── Extra trusted origins (optional) ─────────────────────────────────────────
# Comma-separated list of additional trusted origins (no spaces):
# ALLOWED_ORIGINS=https://my-preview.vercel.app,https://staging.example.com
