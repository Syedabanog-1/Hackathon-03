# LearnFlow Frontend — Local Development Environment
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Better Auth — required for login/signup to work
# Generate secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here-change-this

# Better Auth base URL — use localhost for local dev
BETTER_AUTH_URL=http://localhost:3000

# Neon PostgreSQL — required for Better Auth user/session tables
# Get from neon.tech → your project → Connection String
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Backend API URL — local: run `uvicorn main:app` in learnflow-app/api/
# Production (Railway): replace with your Railway service URL
NEXT_PUBLIC_KONG_URL=http://localhost:8000

# Anthropic API — required for AI Tutor Chat
# Get from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
